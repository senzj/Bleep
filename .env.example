APP_NAME=Bleep
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# mysql, pgsql, sqlsrv, sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

APP_TIMEZONE=UTC
REMEMBERED_LOGOUT="rotate"

# Anonymous functionality
ANONYMITY=false

# Registration (admins can override this in the System page)
REGISTRATION_ENABLED=true

# Media uploads (kilobytes)
MEDIA_MAX_BLEEP_FILE_KB=2097152
MEDIA_MAX_CHAT_FILE_KB=2097152
MEDIA_CHUNKED_UPLOAD_THRESHOLD_KB=8192
MEDIA_CHUNK_SIZE_KB=8192

# Secret keys
MIGRATION_SECRET_KEY=""
CACHE_CLEAR_SECRET=""

# Maintenance mode
MAINTENANCE_MODE=false
MAINTENANCE_DURATION= # in minutes, 0 for indefinite

# Reverb configuration
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=0.0.0.0 # Localhost for local development | 0.0.0.0 for external access
REVERB_PORT=8080
REVERB_SCHEME=http # http | https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

PHP_CLI_SERVER_WORKERS=8
